{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "shared/**/*.ts", "vite.config.ts"]
}
