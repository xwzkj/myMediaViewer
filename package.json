{
  "name": "media-garden",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:fixtures": "tsx tests/preview-fixtures.ts",
    "test:search": "tsx tests/search-benchmark.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@mdi/js": "^7.4.47",
    "fastify": "^5.6.0",
    "fuse.js": "^7.1.0",
    "opencc-js": "^1.0.5",
    "pinyin-pro": "^3.27.0",
    "sharp": "^0.34.5",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.15.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vue-tsc": "^3.1.4"
  }
}
