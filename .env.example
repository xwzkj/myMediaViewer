# 复制为 .env 后按需修改；Node 内置解析，已存在的真实环境变量优先。
# 主服务与计算端读取同一个仓库根目录的 .env；用 ENV_FILE 可指向别的文件。
# 这个文件本身不要提交（.gitignore 已包含 .env）。

# ── 主服务 ─────────────────────────────────────────────
# PORT=3210
# HOST=0.0.0.0
# MEDIA_DATA_DIR=./data
# FFMPEG_PATH=ffmpeg
# ALLOW_PUBLIC_ACCESS=0
# LOG_LEVEL=debug        # 需要 Fastify 逐请求日志时打开

# ── 远程计算端（pnpm run start:compute）────────────────
# 运行计算端的机器必须有这个 Key；主服务在设置页填入同一个值。
COMPUTE_API_KEY=
# COMPUTE_PORT=3211
# COMPUTE_HOST=0.0.0.0
# COMPUTE_WORK_DIR=./data-compute/work
# MANGA_MODEL_DIR=./data/models
# SEMANTIC_CLIP_MODEL_DIR=./data/models/clip-vit-b32
# COMPUTE_INTRA_OP_THREADS=4
# COMPUTE_CONCURRENCY=1
# SEMANTIC_CLIP_THREADS=4

# ── 主服务：远程后台预热流水线 ─────────────────────────
# BACKGROUND_CONCURRENCY=3

# ── Ugoira 转码预算（可选，单位见 README）───────────────
# UGOIRA_MAX_FRAMES=10000
# UGOIRA_MAX_UNZIP_BYTES=536870912
# UGOIRA_MAX_FRAME_BYTES=67108864
# UGOIRA_MAX_FRAME_PIXELS=16000000
# UGOIRA_WEBP_MAX_TOTAL_PIXELS=128000000
# UGOIRA_MAX_DURATION_MS=600000
# UGOIRA_MAX_OUTPUT_BYTES=268435456
# UGOIRA_TIMEOUT_MS=600000
